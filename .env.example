# ============================================================
# SkillGraph AI — environment configuration
# Copy this file to .env (backend) and never commit real secrets.
# ============================================================

# --- General ---
ENV=development
SECRET_KEY=change-me-in-production

# --- Database ---
# Default: local SQLite, zero setup required.
DATABASE_URL=sqlite:///./skillgraph.db
# Production example (Postgres + pgvector):
# DATABASE_URL=postgresql://user:password@host:5432/skillgraph

# --- Vector backend ---
# "none" (default, TF-IDF local vector store) or "pgvector"
VECTOR_BACKEND=none

# --- LLM provider (optional — app runs in Demo Intelligence Mode without these) ---
LLM_PROVIDER=auto
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# Frontend (frontend/.env.local)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
