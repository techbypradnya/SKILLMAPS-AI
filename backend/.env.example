# Application Environment
ENV=development
APP_NAME=SkillGraph AI

# Database Configuration
# For SQLite (default): sqlite:///./skillgraph.db
# For PostgreSQL: postgresql://user:password@localhost:5432/skillgraph
DATABASE_URL=sqlite:///./skillgraph.db

# Authentication & Security
SECRET_KEY=your-secret-key-change-this-in-production

# Vector Store Configuration
# Options: none (default), pgvector
VECTOR_BACKEND=none

# LLM Provider Configuration
# Supported: anthropic, openai, none (demo mode)
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
